<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_BEARSAMPP_STATS</name>
	<author>Bearsampp</author>
	<creationDate>2026 October 07</creationDate>
	<copyright>Copyright (C) 2025 - 2026 Bearsampp</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorEmail>support@bearsampp.com</authorEmail>
	<authorUrl>https://bearsampp.com</authorUrl>
	<version>2026.10.07.1</version>
	<description>MOD_BEARSAMPP_STATS_DESC</description>
	<namespace path="src">Bearsampp\Module\Stats</namespace>
	<dependencies>
		<php version="8.1" />
		<joomla version="5.4" />
	</dependencies>

	<files>
		<filename module="mod_bearsampp_stats">mod_bearsampp_stats.php</filename>
		<filename>mod_bearsampp_stats.xml</filename>
		<filename>helper.php</filename>
		<folder>tmpl</folder>
		<folder>media</folder>
		<folder>language</folder>
	</files>

	<media destination="mod_bearsampp_stats" folder="media">
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<languages>
		<language tag="en-GB">language/en-GB/mod_bearsampp_stats.ini</language>
		<language tag="en-GB">language/en-GB/mod_bearsampp_stats.sys.ini</language>
	</languages>
	<updateservers>
		<server type="extension" priority="1" name="Bearsampp Stats Updates">https://raw.githubusercontent.com/Bearsampp/mod_bearsampp_stats/main/updates.xml</server>
	</updateservers>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="modules_list"
					type="textarea"
					label="MOD_BEARSAMPP_STATS_MODULES_LABEL"
					description="MOD_BEARSAMPP_STATS_MODULES_DESC"
					rows="6"
					cols="40"
					default="module-apache,module-bruno,module-composer,module-ghostscript,module-git,module-mailpit,module-mariadb,module-memcached,module-mysql,module-ngrok,module-nodejs,module-perl,module-php,module-phpmyadmin,module-phppgadmin,module-postgresql,module-powershell,module-python,module-ruby,module-xlight"
				/>
				<field
					name="parent_repo"
					type="text"
					label="MOD_BEARSAMPP_STATS_PARENT_LABEL"
					description="MOD_BEARSAMPP_STATS_PARENT_DESC"
					default="https://github.com/Bearsampp"
					size="40"
				/>
				<field
					name="branch"
					type="text"
					label="MOD_BEARSAMPP_STATS_BRANCH_LABEL"
					description="MOD_BEARSAMPP_STATS_BRANCH_DESC"
					default="main"
					size="10"
				/>
				<field
					name="stats_folder"
					type="text"
					label="MOD_BEARSAMPP_STATS_FOLDER_LABEL"
					description="MOD_BEARSAMPP_STATS_FOLDER_DESC"
					default="gh-dl"
					size="20"
				/>
				<field
					name="cache_ttl_minutes"
					type="number"
					label="MOD_BEARSAMPP_STATS_CACHE_TTL_LABEL"
					description="MOD_BEARSAMPP_STATS_CACHE_TTL_DESC"
					default="30"
					min="0"
					max="720"
					step="5"
				/>
				<field
					name="show_icons"
					type="radio"
					label="MOD_BEARSAMPP_STATS_SHOW_ICONS_LABEL"
					description="MOD_BEARSAMPP_STATS_SHOW_ICONS_DESC"
					class="btn-group btn-group-yesno"
					default="1"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
				<field
					name="icon_class"
					type="text"
					label="MOD_BEARSAMPP_STATS_ICON_LABEL"
					description="MOD_BEARSAMPP_STATS_ICON_DESC"
					default="fas fa-chart-bar"
					size="30"
				/>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
				/>
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
